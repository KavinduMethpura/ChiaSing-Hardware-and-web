# PlantHead Device Environment Configuration
# Copy this file to .env on each Raspberry Pi: cp .env.example .env
# NEVER commit the actual .env file to git!

# Device Identity (unique per Raspberry Pi: planthead1, planthead2, planthead3, planthead4, planthead5)
DEVICE_ID=planthead1

# Adafruit IO Credentials
AIO_USERNAME=your_adafruit_io_username
AIO_KEY=your_adafruit_io_key

# Optional: Feed Key Overrides (defaults to <group>.<feed>: planthead1.planthead1-soil-moisture)
# FEED_SOIL_MOISTURE=planthead1.planthead1-soil-moisture
# FEED_SOIL_TEMP=planthead1.planthead1-soil-temp
# FEED_AUDIO_LOG=planthead1.planthead1-audio-log

# Google Drive Target Folder IDs (from your Google Drive folder URLs)
GDRIVE_IMAGES_FOLDER_ID=your_images_folder_id_here
GDRIVE_AUDIO_FOLDER_ID=your_audio_folder_id_here
GDRIVE_MUSIC_FOLDER_ID=your_shared_music_folder_id_here

# Local Flask API Port (default: 5000)
API_PORT=5000

# Sampling Intervals (seconds)
SOIL_INTERVAL_SEC=30
CAMERA_INTERVAL_SEC=60

# Audio Hardware Device (plughw:0,0 on Pi Zero Lite)
ALSA_DEVICE=plughw:0,0
SPEAKER_ALSA_DEVICE=plughw:0,0
